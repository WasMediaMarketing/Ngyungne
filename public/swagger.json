{
  "openapi": "3.0.0",
  "info": {
    "title": "My API",
    "version": "1.0.0",
    "description": "This is the API documentation for my Next.js app."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api"
    }
  ],
  "paths": {
    "/api/user": {
      "post": {
        "summary": "Create a new user",
        "description": "This endpoint creates a new user in the system.",
        "tags": [
          "User"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Name of the user"
                  },
                  "email": {
                    "type": "string",
                    "description": "Email of the user"
                  },
                  "phoneNumber": {
                    "type": "string",
                    "description": "Phone number of the user"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "user",
                      "admin",
                      "volunteer",
                      "donator"
                    ],
                    "description": "Role of the user"
                  },
                  "password": {
                    "type": "string",
                    "description": "Password of the user (only required for creating new admin)"
                  },
                  "page": {
                    "type": "string",
                    "description": "Page for the user (required for non-admin users)"
                  },
                  "pageTitle": {
                    "type": "string",
                    "description": "Page title for the user (required for non-admin users)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully"
          },
          "400": {
            "description": "Bad request if input validation fails"
          },
          "401": {
            "description": "Unauthorized if token is invalid or missing"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "get": {
        "summary": "Get all users",
        "description": "This endpoint retrieves all users in the system.",
        "tags": [
          "User"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "required": true,
            "schema": {
              "type": "string",
              "example": "Bearer <your_token_here>"
            },
            "description": "Authorization token required to access this endpoint."
          }
        ],
        "responses": {
          "200": {
            "description": "List of users retrieved successfully"
          },
          "401": {
            "description": "Unauthorized if token is invalid or missing"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "delete": {
        "summary": "Delete users by their IDs",
        "description": "Delete multiple users based on their user IDs.",
        "tags": [
          "User"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "userIds",
            "required": true,
            "schema": {
              "type": "string",
              "example": "1,2,3,4"
            },
            "description": "A comma-separated list of user IDs to delete."
          },
          {
            "in": "header",
            "name": "Authorization",
            "required": true,
            "schema": {
              "type": "string",
              "example": "Bearer <your_token_here>"
            },
            "description": "Authorization token required to access this endpoint."
          }
        ],
        "responses": {
          "200": {
            "description": "Users successfully deleted."
          },
          "401": {
            "description": "Unauthorized - The request is not authenticated."
          },
          "404": {
            "description": "No users found for the given IDs."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/user/login": {
      "post": {
        "summary": "Login user and return JWT token",
        "description": "This endpoint allows a user to log in by providing their email and password. On successful login, a JWT token is returned.",
        "tags": [
          "User"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "The user's email address."
                  },
                  "password": {
                    "type": "string",
                    "description": "The user's password."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User logged in successfully, returns the user details and JWT token.",
            "content": {
              "application/json": null,
              "schema": {
                "type": "object",
                "properties": {
                  "user": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "The user ID."
                      },
                      "name": {
                        "type": "string",
                        "description": "The user's name."
                      },
                      "email": {
                        "type": "string",
                        "description": "The user's email address."
                      },
                      "role": {
                        "type": "string",
                        "description": "The user's role (e.g., admin, user, etc.)."
                      }
                    }
                  },
                  "token": {
                    "type": "string",
                    "description": "The JWT token for authenticated requests."
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid credentials or bad request."
          },
          "401": {
            "description": "Unauthorized if the login credentials are invalid."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/init-admin": {
      "get": {
        "summary": "Initializes the admin user if it doesn't exist",
        "description": "Checks if an admin user exists in the database, and if not, creates one with the email and password specified in environment variables.",
        "tags": [
          "Admin"
        ],
        "responses": {
          "200": {
            "description": "Admin check complete. Admin user exists or has been created successfully.",
            "content": {
              "application/json": null,
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Message indicating the status of the admin user creation.",
                    "example": "Admin check complete"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error. Could not initialize the admin user.",
            "content": {
              "application/json": null,
              "schema": {
                "type": "object",
                "properties": {
                  "error": {
                    "type": "string",
                    "description": "Error message indicating the failure reason.",
                    "example": "Failed to initialize admin user"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/donation": {
      "post": {
        "summary": "Create a new donation",
        "description": "This endpoint allows the user to create a new donation.",
        "tags": [
          "Donation"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "number",
                    "description": "Donation amount (must be greater than 0)."
                  },
                  "name": {
                    "type": "string",
                    "description": "Donor's name."
                  },
                  "email": {
                    "type": "string",
                    "description": "Donor's email."
                  },
                  "phoneNumber": {
                    "type": "string",
                    "description": "Donor's phone number."
                  },
                  "screenshot": {
                    "type": "string",
                    "format": "uri",
                    "description": "A URL for the screenshot of the donation."
                  },
                  "donationType": {
                    "type": "string",
                    "description": "Type of donation (e.g., \"charity\", \"event\")."
                  },
                  "donationMethod": {
                    "type": "string",
                    "description": "Method of donation (e.g., \"credit card\", \"paypal\")."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Donation successfully created"
          },
          "400": {
            "description": "Bad request if the input is invalid"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "get": {
        "summary": "Get all donations",
        "description": "This endpoint retrieves all donations in the system.",
        "tags": [
          "Donation"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "required": true,
            "schema": {
              "type": "string",
              "example": "Bearer <your_token_here>"
            },
            "description": "Authorization token required to access this endpoint."
          }
        ],
        "responses": {
          "200": {
            "description": "List of donations retrieved successfully"
          },
          "401": {
            "description": "Unauthorized if token is invalid or missing"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "delete": {
        "summary": "Delete donations by their IDs",
        "description": "Delete donations based on their donation IDs.",
        "tags": [
          "Donation"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "donationIds",
            "required": true,
            "schema": {
              "type": "string",
              "example": "1,2,3,4"
            },
            "description": "A comma-separated list of donation IDs to delete."
          },
          {
            "in": "header",
            "name": "Authorization",
            "required": true,
            "schema": {
              "type": "string",
              "example": "Bearer <your_token_here>"
            },
            "description": "Authorization token required to access this endpoint."
          }
        ],
        "responses": {
          "200": {
            "description": "Donations successfully deleted"
          },
          "401": {
            "description": "Unauthorized - The request is not authenticated"
          },
          "404": {
            "description": "No donations found for the given IDs"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/contact": {
      "delete": {
        "summary": "Delete multiple contacts by their IDs",
        "description": "This endpoint deletes multiple contact entries based on the provided comma-separated list of contact IDs.",
        "tags": [
          "Contact"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "contactIds",
            "required": true,
            "schema": {
              "type": "string",
              "example": "123,456,789"
            },
            "description": "A comma-separated list of contact IDs to delete."
          },
          {
            "in": "header",
            "name": "Authorization",
            "required": true,
            "schema": {
              "type": "string",
              "example": "Bearer <your_token_here>"
            },
            "description": "Authorization token required to access this endpoint."
          }
        ],
        "responses": {
          "200": {
            "description": "Contacts successfully deleted."
          },
          "400": {
            "description": "Bad request if the IDs are invalid or improperly formatted."
          },
          "401": {
            "description": "Unauthorized - The request is not authenticated or the token is invalid."
          },
          "404": {
            "description": "No contacts found for the provided IDs."
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "get": {
        "summary": "Get all contacts",
        "description": "This endpoint retrieves all the contact entries in the system.",
        "tags": [
          "Contact"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "required": true,
            "schema": {
              "type": "string",
              "example": "Bearer <your_token_here>"
            },
            "description": "Authorization token required to access this endpoint."
          }
        ],
        "responses": {
          "200": {
            "description": "List of contacts retrieved successfully"
          },
          "401": {
            "description": "Unauthorized if token is invalid or missing"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "summary": "Create a new contact",
        "description": "This endpoint allows you to create a new contact entry in the system.",
        "tags": [
          "Contact"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "The name of the contact."
                  },
                  "email": {
                    "type": "string",
                    "description": "The email of the contact."
                  },
                  "phoneNumber": {
                    "type": "string",
                    "description": "The phone number of the contact."
                  },
                  "page": {
                    "type": "string",
                    "description": "(Optional) The page associated with the contact."
                  },
                  "pageTitle": {
                    "type": "string",
                    "description": "(Optional) The page title associated with the contact."
                  },
                  "subject": {
                    "type": "string",
                    "description": "The subject of the contact message."
                  },
                  "message": {
                    "type": "string",
                    "description": "The content of the contact message."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Contact created successfully"
          },
          "400": {
            "description": "Bad request if input validation fails"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/event": {
      "post": {
        "summary": "Create a new event",
        "description": "This endpoint creates a new event with images, schedule, teacher data, and other required information.",
        "operationId": "createEvent",
        "tags": [
          "Event"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "Event image (optional, processed later)"
                  },
                  "teacherImage": {
                    "type": "string",
                    "format": "binary",
                    "description": "Teacher's image (optional, processed later)"
                  },
                  "title": {
                    "type": "string",
                    "description": "Title of the event"
                  },
                  "description": {
                    "type": "string",
                    "description": "Description of the event"
                  },
                  "type": {
                    "type": "string",
                    "description": "Type of the event (e.g., conference, seminar, etc.)"
                  },
                  "date": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Date of the event"
                  },
                  "time": {
                    "type": "string",
                    "description": "Time of the event"
                  },
                  "location": {
                    "type": "string",
                    "description": "Location where the event will take place"
                  },
                  "teacher": {
                    "type": "object",
                    "description": "Teacher details (name, image, etc.)",
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "Teacher's name"
                      },
                      "speciality": {
                        "type": "string",
                        "description": "Teacher's speciality"
                      },
                      "description": {
                        "type": "string",
                        "description": "Teacher's description"
                      },
                      "image": {
                        "type": "string",
                        "format": "uri",
                        "description": "Teacher's image URL"
                      },
                      "link": {
                        "type": "string",
                        "description": "Link to teacher's profile"
                      },
                      "credentials": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "description": "Teacher's credentials"
                      }
                    }
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Tags related to the event"
                  },
                  "attending": {
                    "type": "integer",
                    "description": "Number of people attending"
                  },
                  "capacity": {
                    "type": "integer",
                    "description": "Maximum capacity for the event"
                  },
                  "schedule": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "title": {
                          "type": "string",
                          "description": "Title of the schedule item"
                        },
                        "description": {
                          "type": "string",
                          "description": "Description of the schedule item"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Success message"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or validation error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Retrieve all events",
        "description": "Fetches all the events from the database.",
        "operationId": "getEvents",
        "tags": [
          "Event"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer"
                      },
                      "title": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "date": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "delete": {
        "summary": "Delete multiple events",
        "description": "This endpoint deletes multiple events by their IDs, which are passed in the query parameters.",
        "operationId": "deleteEvents",
        "tags": [
          "Event"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "eventIds",
            "required": true,
            "description": "Comma-separated list of event IDs to be deleted.",
            "schema": {
              "type": "string",
              "example": "1,2,3"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Events deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Success message indicating the deletion"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or missing eventIds",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {},
  "tags": []
}